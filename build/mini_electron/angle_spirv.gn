# Metal and D3D11 use ANGLE's common strong ID types, not its SPIR-V compiler.
# Upstream's combined BUILD.gn also resolves unused Vulkan-only targets and
# requires unfetched SPIRV-Tools. Keep only the real target these backends use.
import("../../../gni/angle.gni")

assert(!angle_enable_vulkan && !use_fuzzing_engine,
       "The mini-electron ANGLE build supports Metal and D3D11 only.")

angle_source_set("angle_spirv_headers") {
  sources = [ "spirv_types.h" ]
  deps = [ "$angle_root:angle_common" ]
}
