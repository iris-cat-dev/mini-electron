assert(host_os == "win", "The ANGLE-only backend requires Windows.")
target_os = "win"
target_cpu = "x64"
current_os = target_os
current_cpu = target_cpu
is_win = true
is_mac = false
is_ios = false
is_linux = false
is_chromeos = false
is_android = false
is_fuchsia = false
is_castos = false
is_nacl = false
is_posix = false
is_clang = true
is_debug = false
is_official_build = true
is_component_build = false
# This standalone root has no Chromium sanitizer configuration.
is_cfi = false
use_cfi_icall = false
use_cfi_cast = false

# ANGLE's standalone GN mode avoids Chromium base, workers and toolchains.
declare_args() {
  mini_electron_llvm_bin = ""
}

set_default_toolchain("//toolchain:windows")
foreach(type, [ "source_set", "static_library", "shared_library", "executable" ]) {
  set_defaults(type) {
    configs = [ "//:compiler" ]
  }
}
