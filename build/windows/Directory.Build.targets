<Project>
  <PropertyGroup>
    <UseMultiToolTask Condition="'$(UseMultiToolTask)' == ''">true</UseMultiToolTask>
    <EnforceProcessCountAcrossBuilds Condition="'$(EnforceProcessCountAcrossBuilds)' == ''">true</EnforceProcessCountAcrossBuilds>
    <MiniElectronSourceRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..'))</MiniElectronSourceRoot>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <TreatWarningAsError>false</TreatWarningAsError>
      <PreprocessorDefinitions Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">ANGLE_STATIC=1;GL_APICALL=;EGLAPI=;GL_API=;MINI_ELECTRON_DISABLE_DEVTOOLS=1;MINI_ELECTRON_DISABLE_PERMISSION_ELEMENT=1;HAVE_INSPECTOR=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MiniElectronSourceRoot)third_party\dawn\include;$(MiniElectronSourceRoot)third_party\dawn\src;$(MiniElectronDawnRoot)\gen\include;$(MiniElectronDawnRoot)\gen\src;$(MiniElectronSourceRoot)third_party\angle\include;$(MiniElectronSourceRoot)third_party\libyuv\include;$(MiniElectronGeneratedRoot);$(MSBuildThisFileDirectory)..\..;$(MSBuildThisFileDirectory)..\..\third_party\leveldb;$(MSBuildThisFileDirectory)..\..\third_party\leveldb\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>%(AdditionalOptions) -Wno-everything -Wno-error</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64' and '$(MSBuildProjectName)' == 'application'">
    <ClCompile>
      <PreprocessorDefinitions>CURL_STATICLIB;WINVER=0x0A00;_WIN32_WINNT=0x0A00;HAVE_CRC32C=0;HAVE_SNAPPY=0;LEVELDB_COMPILE_LIBRARY;LEVELDB_HAS_PORT_CONFIG_H=0;LEVELDB_PLATFORM_WINDOWS=1;SQLITE_THREADSAFE=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(MiniElectronANGLELibrary);Dxguid.lib;Dxgi.lib;D3d11.lib;Setupapi.lib;Comctl32.lib;Bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="MiniElectronRequireANGLE" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)|$(Platform)' == 'Release|x64' and '$(MSBuildProjectName)' == 'application'">
    <Error Condition="'$(MiniElectronANGLELibrary)' == '' or !Exists('$(MiniElectronANGLELibrary)')" Text="ANGLE D3D11 is required. Use Python 3.12+ and python build.py with GN/Ninja on PATH to bootstrap and build ANGLE, or pass MiniElectronANGLELibrary pointing to that build's mini_electron_angle.lib." />
  </Target>
  <Import Project="$(MiniElectronDawnRoot)\dawn-libraries.props" Condition="Exists('$(MiniElectronDawnRoot)\dawn-libraries.props') and '$(MSBuildProjectName)' == 'application'" />
  <Import Project="$(MSBuildThisFileDirectory)webgpu_sources.props" />
  <Target Name="MiniElectronRequireDawn" BeforeTargets="PrepareForBuild" Condition="'$(MSBuildProjectName)' == 'application'">
    <Error Condition="'$(MiniElectronDawnRoot)' == '' or !Exists('$(MiniElectronDawnRoot)\dawn-libraries.props')" Text="Native Dawn D3D12 and generated headers are required. Use python build.py with CMake 3.24+ and Visual Studio 2022 to bootstrap Dawn, or pass MiniElectronDawnRoot from that build." />
  </Target>
  <UsingTask TaskName="MiniElectronObjectPaths" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <SourceRoot ParameterType="System.String" Required="true" />
      <ObjectRoot ParameterType="System.String" Required="true" />
      <Result ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Result = Sources;
        string objectRoot = Path.GetFullPath(ObjectRoot);
        using (var hash = SHA256.Create()) {
          foreach (var item in Sources) {
            string source = item.GetMetadata("FullPath");
            string relative = source.StartsWith(SourceRoot, StringComparison.OrdinalIgnoreCase)
                ? source.Substring(SourceRoot.Length) : source;
            string output = Path.Combine(objectRoot, relative + ".obj");
            // FileTracker appends temporary suffixes and still enforces MAX_PATH.
            if (Path.IsPathRooted(relative) || output.Length > 200) {
              string key = BitConverter.ToString(hash.ComputeHash(Encoding.UTF8.GetBytes(relative))).Replace("-", "");
              output = Path.Combine(objectRoot, key + ".obj");
            }
            item.SetMetadata("ObjectFileName", output);
          }
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="MiniElectronPrepareObjectPaths" BeforeTargets="PrepareForBuild;WarnCompileDuplicatedFilename">
    <MiniElectronObjectPaths Sources="@(ClCompile)" SourceRoot="$(MiniElectronSourceRoot)" ObjectRoot="$(IntDir)objects\">
      <Output TaskParameter="Result" ItemName="_MiniElectronCompileItems" />
    </MiniElectronObjectPaths>
    <ItemGroup>
      <ClCompile Remove="@(ClCompile)" />
      <ClCompile Include="@(_MiniElectronCompileItems)" />
      <_MiniElectronObjectFiles Include="@(ClCompile->'%(ObjectFileName)')" />
    </ItemGroup>
    <MakeDir Directories="@(_MiniElectronObjectFiles->'%(RootDir)%(Directory)')" />
  </Target>
</Project>
