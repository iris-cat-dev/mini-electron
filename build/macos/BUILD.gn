declare_args() {
  mini_electron_nghttp2_root = "//.build-tools/nghttp2-1.61.0-darwin-arm64"
  mini_electron_curl_root = "//.build-tools/curl-8.23.0-darwin-arm64"
  mini_electron_dawn_root = "//.build-tools/dawn-73dbf565079c89a531e6e01c4e8fc048a8a9660b-darwin-arm64"
}

import("$mini_electron_dawn_root/libraries.gni")

source_set("engine_probe") {
  sources = [
    "//src/platform/macos/smoke/engine_probe.cc",
    "//src/platform/macos/smoke/engine_probe.h",
  ]

  deps = [
    "//v8:v8",
    "//v8:v8_libbase",
    "//v8:v8_libplatform",
  ]
}

# These defines affect Skia's ABI, including clients using raster surfaces.
config("mini_electron_skia_config") {
  defines = [
    "SK_GANESH",
    "SK_METAL",
  ]
}

config("mini_electron_engine_config") {
  configs = [ ":mini_electron_skia_config" ]
  defines = [
    "BLINK_IMPLEMENTATION=1",
    "CPPGC_CAGED_HEAP",
    "CPPGC_ENABLE_LARGER_CAGE",
    "CPPGC_POINTER_COMPRESSION",
    "CPPGC_SLIM_WRITE_BARRIER",
    "CPPGC_YOUNG_GENERATION",
    "CURL_STATICLIB",
    "MINI_ELECTRON_IMPLEMENTATION=1",
    "MINI_ELECTRON_USE_OPENSSL=1",
    "INSIDE_BLINK=1",
    "LIBXML_STATIC",
    "MINI_ELECTRON_DISABLE_DEVTOOLS=1",
    "MINI_ELECTRON_DISABLE_PERMISSION_ELEMENT=1",
    "MINI_ELECTRON_DISABLE_MEDIA_ELEMENT_CAPTURE=1",
    "LIBXSLT_STATIC",
    "PNG_SET_OPTION_SUPPORTED",
    "SK_SUPPORT_LEGACY_DRAWLOOPER",
    "U_DEFINE_FALSE_AND_TRUE",
    "U_STATIC_IMPLEMENTATION",
    "V8_31BIT_SMIS_ON_64BIT_ARCH",
    "V8_ARRAY_BUFFER_INTERNAL_FIELD_COUNT=0",
    "V8_ARRAY_BUFFER_VIEW_INTERNAL_FIELD_COUNT=0",
    "V8_COMPRESS_POINTERS",
    "V8_COMPRESS_POINTERS_IN_SHARED_CAGE",
    "V8_ENABLE_CONTINUATION_PRESERVED_EMBEDDER_DATA",
    "V8_EXTERNAL_CODE_SPACE",
    "V8_PROMISE_INTERNAL_FIELD_COUNT=0",
    "V8_HAVE_TARGET_OS",
    "V8_TARGET_ARCH_ARM64",
    "V8_TARGET_OS_MACOS",
    "USE_AURA",
  ]

  # This port still compiles legacy engine sources with a modern toolchain.
  # Keep release output readable until those inherited sources are refreshed.
  cflags_c = [ "-w" ]
  cflags_cc = [ "-w" ]
  cflags_objcc = [ "-w" ]
  ldflags = [ "-Wl,-w" ]

  include_dirs = [
    "//",
    "//gen",
    "//gen/v8/include",
    "//third_party/dawn/include",
    "//third_party/dawn/src",
    "$mini_electron_dawn_root/gen/include",
    "$mini_electron_dawn_root/gen/src",
    "//src/platform/posix/win32",
    "//gpu",
    "//base/allocator/partition_allocator/src",
    "//gen/base/allocator/partition_allocator/src",
    "//third_party/abseil-cpp",
    "//third_party/brotli/include",
    "//third_party/harfbuzz-ng/src/src",
    "//third_party/iccjpeg",
    "//third_party/icu/source/common",
    "//third_party/icu/source/i18n",
    "//third_party/khronos",
    "//third_party/libjpeg_turbo",
    "//third_party/libyuv/include",
    "//third_party/libpng",
    "//third_party/libwebp/src/src",
    "//third_party/libxml/src/include",
    "//third_party/libxslt/src",
    "//third_party/openssl",
    "//third_party/openssl/openssl/include",
    "//net/third_party/quiche/src",
    "//net/third_party/quiche/overrides",
    "//third_party/protobuf/src",
    "//third_party/re2/src",
    "//third_party/snappy/mac",
    "//third_party/snappy/src",
    "//third_party/skia",
    "//third_party/zlib",
    "//v8",
    "//v8/include",
  ]
}
config("mini_electron_sqlite_config") {
  defines = [
    "SQLITE_ENABLE_COLUMN_METADATA",
    "SQLITE_ENABLE_PREUPDATE_HOOK",
    "SQLITE_ENABLE_SESSION",
    "SQLITE_THREADSAFE=1",
  ]
  include_dirs = [ "//third_party/sqlite" ]
}

config("mini_electron_node_config") {
  defines = [
    "CARES_STATICLIB",
    "DISABLE_SINGLE_EXECUTABLE_APPLICATION",
    "HAVE_AMARO=0",
    "HAVE_INSPECTOR=0",
    "HAVE_OPENSSL=1",
    "HAVE_SQLITE=1",
    "NODE_ARCH=\"arm64\"",
    "NODE_BUNDLED_ZLIB=1",
    "NODE_HAVE_I18N_SUPPORT=1",
    "NODE_OPENSSL_SYSTEM_CERT_PATH=\"\"",
    "NODE_PLATFORM=\"darwin\"",
    "NODE_REPORT",
    "NODE_USE_V8_PLATFORM=1",
    "NODE_WANT_INTERNALS=1",
    "OPENSSL_API_COMPAT=0x10100001L",
    "STATIC_LEGACY",
    "__POSIX__",
  ]

  include_dirs = [
    "$mini_electron_nghttp2_root/include",
    "//third_party/cares/include",
    "//third_party/cares/src/lib",
