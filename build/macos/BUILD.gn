  include_dirs = [
    "$mini_electron_nghttp2_root/include",
    "//third_party/cares/include",
    "//third_party/cares/src/lib",
    "//third_party/libnode/deps/ada",
    "//third_party/libnode/deps/histogram/include",
    "//third_party/libnode/deps/llhttp/include",
