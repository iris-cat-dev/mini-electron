action("stage_devtools_frontend") {
  script = "copy_devtools_frontend.py"
  _source = "//third_party/devtools-frontend/generated/front_end"
  _destination = "$root_out_dir/resources/devtools-frontend/front_end"
  _stamp = "$root_out_dir/resources/devtools-frontend.stamp"
  _inputs = exec_script(
      script,
      [
        "--source=" + rebase_path(_source, root_build_dir),
        "--print-inputs",
      ],
      "list lines")
  inputs = [ "//third_party/devtools-frontend/REVISION" ] + _inputs
  outputs = [ _stamp ]
  args = [
    "--source=" + rebase_path(_source, root_build_dir),
    "--destination=" + rebase_path(_destination, root_build_dir),
    "--stamp=" + rebase_path(_stamp, root_build_dir),
  ]
}

executable("mini_electron") {
  output_name = "mini-electron"
  sources = mini_electron_mac_electron_sources
  configs += [ ":mini_electron_engine_config" ]
  _source_root = rebase_path("//", "")
  defines = [
    "HAVE_CRC32C=0",
    "HAVE_SNAPPY=0",
    "LEVELDB_COMPILE_LIBRARY",
    "LEVELDB_HAS_PORT_CONFIG_H=0",
    "LEVELDB_PLATFORM_POSIX=1",
    "MINI_ELECTRON_SOURCE_ROOT=\"$_source_root\"",
    "SQLITE_OMIT_LOAD_EXTENSION",
    "SQLITE_THREADSAFE=1",
  ]
  include_dirs = [
    "//third_party/leveldb",
    "//third_party/leveldb/include",
  ]
  deps = [
    ":mini_electron_engine",
    ":mini_electron_engine_api",
    ":mini_electron_node",
    ":stage_devtools_frontend",
    "//third_party/Squirrel.Mac-main:squirrel_framework+link",
  ]
  libs = [
    rebase_path("$mini_electron_nghttp2_root/lib/libnghttp2.a", root_build_dir),
    "curl",
    "iconv",
  ]
  inputs = [
    "$mini_electron_nghttp2_root/lib/libnghttp2.a",
    "//platform/macos/node_exports.txt",
  ]
  ldflags = [
    "-Wl,-exported_symbols_list," +
        rebase_path("//platform/macos/node_exports.txt", root_build_dir),
    "-rpath",
    "@executable_path/../Frameworks",
    "-rpath",
    "@executable_path",
  ]
  frameworks = [
    "Carbon.framework",
    "CoreServices.framework",
    "AppKit.framework",
    "CoreFoundation.framework",
    "CoreGraphics.framework",
    "CoreText.framework",
    "Foundation.framework",
    "UserNotifications.framework",
    "MediaAccessibility.framework",
    "IOSurface.framework",
    "QuartzCore.framework",
    "Security.framework",
    "ServiceManagement.framework",
    "UniformTypeIdentifiers.framework",
  ]
}
