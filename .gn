# GN backend for macOS. The shared project entry point is build.py.
buildconfig = "//build/config/BUILDCONFIG.gn"
script_executable = "python3"

default_args = {
  v8_enable_gdbjit = false
  v8_imminent_deprecation_warnings = false
  clang_unsafe_buffers_paths = "//build/config/unsafe_buffers_paths.txt"
  # WebGL uses ANGLE directly, without Chromium's GPU service or unused backends.
  angle_enable_vulkan = false
  angle_enable_gl = false
  angle_enable_null = false
  angle_enable_d3d9 = false
  angle_enable_abseil = false
  angle_has_astc_encoder = false
  angle_has_rapidjson = false
  angle_has_histograms = false
  angle_delegate_workers = false
  angle_build_tests = false
  angle_build_vulkan_system_info = false
  angle_enable_commit_id = false
}
