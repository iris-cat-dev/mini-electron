import("build/sources/allocator.gni")
import("build/sources/base.gni")
import("build/sources/engine.gni")
import("build/sources/generated.gni")
import("build/sources/third_party.gni")

source_set("engine_probe") {
  sources = [
    "smoke/engine_probe.cc",
    "smoke/engine_probe.h",
  ]

  deps = [
    "//v8:v8",
    "//v8:v8_libbase",
    "//v8:v8_libplatform",
  ]
}

config("miniblink_engine_config") {
  defines = [
    "BLINK_IMPLEMENTATION=1",
    "CPPGC_CAGED_HEAP",
    "CPPGC_ENABLE_LARGER_CAGE",
    "CPPGC_POINTER_COMPRESSION",
    "CPPGC_SLIM_WRITE_BARRIER",
    "CPPGC_YOUNG_GENERATION",
    "CURL_STATICLIB",
    "ENABLE_MB=1",
    "INSIDE_BLINK=1",
    "LIBXML_STATIC",
    "LIBXSLT_STATIC",
    "PNG_SET_OPTION_SUPPORTED",
    "SK_SUPPORT_LEGACY_DRAWLOOPER",
    "U_DEFINE_FALSE_AND_TRUE",
    "U_STATIC_IMPLEMENTATION",
    "V8_31BIT_SMIS_ON_64BIT_ARCH",
    "V8_ARRAY_BUFFER_INTERNAL_FIELD_COUNT=0",
    "V8_ARRAY_BUFFER_VIEW_INTERNAL_FIELD_COUNT=0",
    "V8_COMPRESS_POINTERS",
    "V8_COMPRESS_POINTERS_IN_SHARED_CAGE",
    "V8_ENABLE_CONTINUATION_PRESERVED_EMBEDDER_DATA",
    "V8_ENABLE_SANDBOX",
    "V8_EXTERNAL_CODE_SPACE",
    "V8_PROMISE_INTERNAL_FIELD_COUNT=0",
    "V8_HAVE_TARGET_OS",
    "V8_TARGET_ARCH_ARM64",
    "V8_TARGET_OS_MACOS",
    "USE_AURA",
  ]

  # This port still compiles legacy MiniBlink sources with a modern toolchain.
  # Keep release output readable until those inherited sources are refreshed.
  cflags_c = [ "-w" ]
  cflags_cc = [ "-w" ]
  cflags_objcc = [ "-w" ]
  ldflags = [ "-Wl,-w" ]

  include_dirs = [
    "//",
    "//gen",
    "//gen/v8/include",
    "//linux",
    "//gpu",
    "//base/allocator/partition_allocator/src",
    "//gen/base/allocator/partition_allocator/src",
    "//third_party/abseil-cpp",
    "//third_party/brotli/include",
    "//third_party/harfbuzz-ng/src/src",
    "//third_party/iccjpeg",
    "//third_party/icu/source/common",
    "//third_party/icu/source/i18n",
    "//third_party/khronos",
    "//third_party/libjpeg_turbo",
    "//third_party/libyuv/include",
    "//third_party/libpng",
    "//third_party/libwebp/src/src",
    "//third_party/libxml/src/include",
    "//third_party/libxslt/src",
    "//third_party/openssl",
    "//third_party/openssl/openssl/include",
    "//third_party/skia",
    "//third_party/zlib",
    "//v8",
    "//v8/include",
  ]
}


static_library("miniblink_base") {
  sources = miniblink_base_sources
  sources += [
    "//base/apple/call_with_eh_frame_asm.S",
    "//base/base_switches.cc",
    "//base/i18n/icu_string_conversions.cc",
    "//base/i18n/string_search.cc",
    "//base/i18n/time_formatting.cc",
    "//base/task/thread_pool/task_thread_pool.cc",
    "//base/third_party/cityhash/city.cc",
    "//base/third_party/cityhash_v103/src/city_v103.cc",
  ]
  configs += [ ":miniblink_engine_config" ]
  defines = [ "BASE_IMPLEMENTATION" ]
  frameworks = [
    "AppKit.framework",
    "CoreFoundation.framework",
    "Foundation.framework",
  ]
}



static_library("miniblink_openssl") {
  sources = miniblink_openssl_sources
  sources += [ "//third_party/openssl/openssl/providers/implementations/rands/seeding/rand_unix.c" ]
  configs += [ ":miniblink_engine_config" ]
  include_dirs = [
    "//third_party/openssl/openssl",
    "//third_party/openssl/openssl/crypto",
    "//third_party/openssl/openssl/crypto/asn1",
    "//third_party/openssl/openssl/crypto/evp",
    "//third_party/openssl/openssl/crypto/md2",
    "//third_party/openssl/openssl/crypto/modes",
    "//third_party/openssl/openssl/crypto/store",
    "//third_party/openssl/openssl/providers/common/include",
    "//third_party/openssl/openssl/providers/implementations/include",
    "//third_party/openssl/config/archs/VC-WIN32/no-asm/providers/common/include",
  ]
}

