{
  "name": "@iriscat/mini-electron",
  "version": "0.1.11",
  "description": "Electron-compatible desktop runtime for Apple Silicon macOS",
  "license": "Apache-2.0",
  "author": "mini-electron contributors",
  "main": "index.js",
  "types": "electron.d.ts",
  "bin": {
    "electron": "cli.js",
    "mini-electron": "cli.js"
  },
  "dependencies": {
    "@types/node": "^24.0.0"
  },
  "scripts": {
    "postinstall": "node install.js",
    "test": "node --test test/*.test.js",
    "benchmark:render": "node benchmarks/rendering/run.js"
  },
  "files": [
    "cli.js",
    "electron.d.ts",
    "index.js",
    "install.js",
    "lib/",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.17"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "miniElectron": {
    "installerProtocol": 1,
    "electronApiVersion": "41.2.0",
    "downloadBaseUrl": "https://github.com/iris-cat-dev/mini-electron/releases/download",
    "platforms": {
      "darwin-arm64": {
        "executable": "Electron.app/Contents/MacOS/Electron"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iris-cat-dev/mini-electron.git"
  },
  "keywords": [
    "electron",
    "desktop",
    "chromium"
  ]
}
