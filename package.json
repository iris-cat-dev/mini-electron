{
  "name": "@iriscat/mini-electron",
  "version": "0.1.12",
  "description": "Electron-compatible desktop runtime for Windows x64 and Apple Silicon macOS",
  "license": "Apache-2.0",
  "author": "mini-electron contributors",
  "main": "src/npm/index.js",
  "types": "src/npm/electron.d.ts",
  "bin": {
    "electron": "src/npm/cli.js",
    "mini-electron": "src/npm/cli.js"
  },
  "dependencies": {
    "@types/node": "^24.0.0"
  },
  "scripts": {
    "postinstall": "node src/npm/install.js",
    "test": "node --test test/*.test.js",
    "benchmark:render": "node benchmarks/rendering/run.js"
  },
  "files": [
    "src/npm/",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.17"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "miniElectron": {
    "installerProtocol": 1,
    "electronApiVersion": "41.2.0",
    "downloadBaseUrl": "https://github.com/iris-cat-dev/mini-electron/releases/download",
    "platforms": {
      "darwin-arm64": {
        "executable": "Electron.app/Contents/MacOS/Electron",
        "runtimeChannel": "runtime-v1"
      },
      "win32-x64": {
        "executable": "electron.exe",
        "runtimeChannel": "runtime-v1-win32-x64"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iris-cat-dev/mini-electron.git"
  },
  "keywords": [
    "electron",
    "desktop",
    "chromium"
  ]
}
